{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../../scripts/build-family-release.ts",
    "../../scripts/check-installer-wrangler.ts",
    "../../tests/suites/unit/familyRelease.test.ts",
    "../../tests/suites/integration/installer/**/*.test.ts"
  ]
}
